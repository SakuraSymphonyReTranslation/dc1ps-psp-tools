{
  "scene": "script_0396.obj",
  "dialogues": [
    {
      "offset": 159,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 185,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「兄さん、起きてください」",
      "en": "\"Wake up, niisan.\"",
      "text": "\"Wake up, niisan.\""
    },
    {
      "offset": 218,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 244,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「もう、兄さん！　起きてっ」",
      "en": "\"Hey, niisan! Wake up!\"",
      "text": "\"Hey, niisan! Wake up!\""
    },
    {
      "offset": 279,
      "speaker": "",
      "speaker_jp": "",
      "jp": "ゆさゆさと、身体が揺れる。",
      "en": "My body's being shaken.",
      "text": "My body's being shaken."
    },
    {
      "offset": 312,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「ううん……」",
      "en": "\"Uuuuh......\"",
      "text": "\"Uuuuh......\""
    },
    {
      "offset": 363,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 413,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「もう、休みだからって、だらだらしないでく\n　ださい」",
      "en": "\"Please don't be lazy just because you don't have school.\"",
      "text": "\"Please don't be lazy just because you don't have school.\""
    },
    {
      "offset": 473,
      "speaker": "",
      "speaker_jp": "",
      "jp": "目を開けると、天井の手前に呆れたように｛にら／睨｝む\n音夢の顔があった。",
      "en": "When I opened my eyes, I saw Nemu glaring at me with an\namazed expression on her face.",
      "text": "When I opened my eyes, I saw Nemu glaring at me with an\namazed expression on her face."
    },
    {
      "offset": 551,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「んん……休みってのは休むためにあるんじゃ\n　ないのか……」",
      "en": "\"Uhh...... Holidays are there for being lazy......\"",
      "text": "\"Uhh...... Holidays are there for being lazy......\""
    },
    {
      "offset": 651,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 679,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「もう、また寝ない」",
      "en": "\"Hey, don't go back to sleep.\"",
      "text": "\"Hey, don't go back to sleep.\""
    },
    {
      "offset": 706,
      "speaker": "",
      "speaker_jp": "",
      "jp": "ゆさゆさと身体が揺れるが、かまわず｛まぶた／瞼｝を閉じ\n続ける。",
      "en": "My body was being shaken again, but I kept my eyes closed.",
      "text": "My body was being shaken again, but I kept my eyes closed."
    },
    {
      "offset": 774,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 802,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「もう……」",
      "en": "\"Hey......\"",
      "text": "\"Hey......\""
    },
    {
      "offset": 832,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「ああっ、もうこんな時間」",
      "en": "\"Oh no! I'm going to be late!\"",
      "text": "\"Oh no! I'm going to be late!\""
    },
    {
      "offset": 865,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 893,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「私もう行きますけど、兄さんも、ちゃんと起\n　きてくださいよ」",
      "en": "\"I need to go now, but you need to wake up, Okay?\"",
      "text": "\"I need to go now, but you need to wake up, Okay?\""
    },
    {
      "offset": 972,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「――っと、その前に……」",
      "en": "\"......Before I go......\"",
      "text": "\"......Before I go......\""
    },
    {
      "offset": 1005,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 1033,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「これでよし――と」",
      "en": "\"There... this should do it.\"",
      "text": "\"There... this should do it.\""
    },
    {
      "offset": 1071,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "「じゃあ行ってきます、兄さん」",
      "en": "\"See you later, niisan.\"",
      "text": "\"See you later, niisan.\""
    },
    {
      "offset": 1113,
      "speaker": "",
      "speaker_jp": "",
      "jp": "チリン――",
      "en": "Ding-a-ling......",
      "text": "Ding-a-ling......"
    },
    {
      "offset": 1128,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 1143,
      "speaker": "",
      "speaker_jp": "",
      "jp": "鈴の音を最後に、部屋から音が消える。",
      "en": "I heard the bell ring, and the noise disappeared from the\nroom.",
      "text": "I heard the bell ring, and the noise disappeared from the\nroom."
    },
    {
      "offset": 1186,
      "speaker": "",
      "speaker_jp": "",
      "jp": "（ようやく静かになったか……）",
      "en": "(I'm finally at peace......)",
      "text": "(I'm finally at peace......)"
    },
    {
      "offset": 1223,
      "speaker": "",
      "speaker_jp": "",
      "jp": "これで心起きなく眠れる。",
      "en": "I can sleep as long as I wish now.",
      "text": "I can sleep as long as I wish now."
    },
    {
      "offset": 1254,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 1267,
      "speaker": "",
      "speaker_jp": "",
      "jp": "スー……。",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 1400,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆断固眠る◆",
      "en": "◆All I want to do is sleep◆",
      "text": "◆All I want to do is sleep◆"
    },
    {
      "offset": 1434,
      "speaker": "",
      "speaker_jp": "",
      "jp": "音夢が起こしに来たが、俺はずっと眠り続けた\nのだった。",
      "en": "Nemu came to wake me up, but I continued to sleep.",
      "text": "Nemu came to wake me up, but I continued to sleep."
    }
