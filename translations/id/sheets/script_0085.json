{
  "scene": "script_0085.obj",
  "dialogues": [
    {
      "offset": 131,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「なんでこんなところに来てしまったんだ、俺\n　……？」",
      "en": "\"What did I come here for...?\"",
      "text": "\"What did I come here for...?\""
    },
    {
      "offset": 191,
      "speaker": "",
      "speaker_jp": "",
      "jp": "そう呟くものの、そもそもその答えがわからな\nいからそう呟いているわけで……。",
      "en": "As soon as I muttered tha tto myself, I muttered back that I\nwouldn't know anyway.",
      "text": "As soon as I muttered tha tto myself, I muttered back that I\nwouldn't know anyway."
    },
    {
      "offset": 271,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……はぁ。",
      "en": "...Haah.",
      "text": "...Haah."
    },
    {
      "offset": 286,
      "speaker": "",
      "speaker_jp": "",
      "jp": "知らずため息も出てくる。",
      "en": "I unconciously sighed to myself.",
      "text": "I unconciously sighed to myself."
    },
    {
      "offset": 315,
      "speaker": "",
      "speaker_jp": "",
      "jp": "周りでは子供たちが楽しそうに歓声を上げてい\nるし……。",
      "en": "The only things around me were some kids, playing in high\nspirits.",
      "text": "The only things around me were some kids, playing in high\nspirits."
    },
    {
      "offset": 373,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……明らかに浮いている。",
      "en": "...They obviously look happy,",
      "text": "...They obviously look happy,"
    },
    {
      "offset": 402,
      "speaker": "",
      "speaker_jp": "",
      "jp": "とっとと帰ろう……。",
      "en": "I should just go home....",
      "text": "I should just go home...."
    },
    {
      "offset": 427,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……って、ん？",
      "en": "...Uh, hm?",
      "text": "...Uh, hm?"
    },
    {
      "offset": 446,
      "speaker": "",
      "speaker_jp": "",
      "jp": "袖を引っ張られる感覚に下を向くと、にんまり\nとした子供と目が合う。",
      "en": "Feeling my shirt sleeve being pulled, I turned and locked\neyes with one of the aforementioned kids.",
      "text": "Feeling my shirt sleeve being pulled, I turned and locked\neyes with one of the aforementioned kids."
    },
    {
      "offset": 518,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「……なんだ？」",
      "en": "\"...What is it?\"",
      "text": "\"...What is it?\""
    },
    {
      "offset": 547,
      "speaker": "Kid",
      "speaker_jp": "子供",
      "jp": "「おじさん、遊んで」",
      "en": "\"Uncle, want to play?\"",
      "text": "\"Uncle, want to play?\""
    },
    {
      "offset": 574,
      "speaker": "Kid",
      "speaker_jp": "子供",
      "jp": "「…………」",
      "en": "\"......\"",
      "text": "\"......\""
    },
    {
      "offset": 599,
      "speaker": "Kid",
      "speaker_jp": "子供",
      "jp": "「…………」",
      "en": "\"......\"",
      "text": "\"......\""
    },
    {
      "offset": 618,
      "speaker": "Kid",
      "speaker_jp": "子供",
      "jp": "「…………」",
      "en": "\"......\"",
      "text": "\"......\""
    },
    {
      "offset": 637,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……かったるい。",
      "en": "...Geez.",
      "text": "...Geez."
    },
    {
      "offset": 762,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆地味にショック◆",
      "en": "◆A Deep Shock◆",
      "text": "◆A Deep Shock◆"
    },
    {
      "offset": 809,
      "speaker": "",
      "speaker_jp": "",
      "jp": "ぶらりと訪れた公園で、子供におじさんと呼ば\nれた……。",
      "en": "Randomly visting the park, I was called \"Uncle\" by a kid...",
      "text": "Randomly visting the park, I was called \"Uncle\" by a kid..."
    },
    {
      "offset": 867,
      "speaker": "",
      "speaker_jp": "",
      "jp": "地味にショックだ……。",
      "en": "A rather deep shock...",
      "text": "A rather deep shock..."
