{
  "scene": "script_0690.obj",
  "dialogues": [
    {
      "offset": 138,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「……繋がったね。啓一くん」",
      "en": "\"......It's connected, Keiichi-kun.\"",
      "text": "\"......It's connected, Keiichi-kun.\""
    },
    {
      "offset": 179,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「うん、繋がったね」",
      "en": "\"Yes, it is.\"",
      "text": "\"Yes, it is.\""
    },
    {
      "offset": 215,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 240,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「……どうしたの？」",
      "en": "\"......What's wrong?\"",
      "text": "\"......What's wrong?\""
    },
    {
      "offset": 276,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「えっ？」",
      "en": "\"What?\"",
      "text": "\"What?\""
    },
    {
      "offset": 299,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「何か、ぼうっとしてるよ」",
      "en": "\"You look absent.\"",
      "text": "\"You look absent.\""
    },
    {
      "offset": 332,
      "speaker": "",
      "speaker_jp": "",
      "jp": "くすっと──啓一と呼ばれた男の子が笑う。",
      "en": "The boy name Keiichi smiled.",
      "text": "The boy name Keiichi smiled."
    },
    {
      "offset": 377,
      "speaker": "",
      "speaker_jp": "",
      "jp": "白い歯。優しげな笑み。そして……｛まぶ／眩｝しそうに\n見上げる、幼い萌先輩。",
      "en": "He has white teeth and a soft smile. Young Moe-sempai looked\nup at him with a glare in her eyes.",
      "text": "He has white teeth and a soft smile. Young Moe-sempai looked\nup at him with a glare in her eyes."
    },
    {
      "offset": 457,
      "speaker": "",
      "speaker_jp": "",
      "jp": "俺は少しだけ、嫉妬を覚えた。",
      "en": "I felt a little bit jealous.",
      "text": "I felt a little bit jealous."
    },
    {
      "offset": 492,
      "speaker": "",
      "speaker_jp": "",
      "jp": "（昔の事だ、こんなの……）",
      "en": "(This is all in the past......)",
      "text": "(This is all in the past......)"
    },
    {
      "offset": 534,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「う、うん……」",
      "en": "\"Y, Yes......\"",
      "text": "\"Y, Yes......\""
    },
    {
      "offset": 557,
      "speaker": "",
      "speaker_jp": "",
      "jp": "何が恥ずかしいのか、顔を赤くする。",
      "en": "Moe-sempai blushed, feeling shy about something.",
      "text": "Moe-sempai blushed, feeling shy about something."
    },
    {
      "offset": 607,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「だって……一人じゃ、トンネルを通したこと\n　なんて、無かったから……」",
      "en": "\"Well...... I've never made a tunnel all by myself......\"",
      "text": "\"Well...... I've never made a tunnel all by myself......\""
    },
    {
      "offset": 691,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「……そう」",
      "en": "\"......I see.\"",
      "text": "\"......I see.\""
    },
    {
      "offset": 710,
      "speaker": "",
      "speaker_jp": "",
      "jp": "あくまで静かに、男の子はうなずく。",
      "en": "The boy nodded quietly.",
      "text": "The boy nodded quietly."
    },
    {
      "offset": 757,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「一人じゃ、難しいのかもしれないね」",
      "en": "\"Maybe it's too difficult to do it by yourself.\"",
      "text": "\"Maybe it's too difficult to do it by yourself.\""
    },
    {
      "offset": 809,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「そう……かな」",
      "en": "\"Do you think so......?\"",
      "text": "\"Do you think so......?\""
    },
    {
      "offset": 838,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「うん」",
      "en": "\"Yes.\"",
      "text": "\"Yes.\""
    },
    {
      "offset": 857,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 894,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「まだ、砂遊び、したい？」",
      "en": "\"Do you want to play in the sand some more?\"",
      "text": "\"Do you want to play in the sand some more?\""
    },
    {
      "offset": 936,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「え……？」",
      "en": "\"What......?\"",
      "text": "\"What......?\""
    },
    {
      "offset": 955,
      "speaker": "",
      "speaker_jp": "",
      "jp": "ぽかんと、萌先輩が男の子を見上げる。",
      "en": "Moe-sempai looked up at the boy with a surprised face.",
      "text": "Moe-sempai looked up at the boy with a surprised face."
    },
    {
      "offset": 1004,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「どっか、他の所に行こうよ」",
      "en": "\"Let's go somewhere else.\"",
      "text": "\"Let's go somewhere else.\""
    },
    {
      "offset": 1048,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 1073,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「僕、もっと面白い場所、知ってるよ」",
      "en": "\"I know somewhere more exciting.\"",
      "text": "\"I know somewhere more exciting.\""
    },
    {
      "offset": 1122,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「虫が捕れる所」",
      "en": "\"Somewhere we can catch some bugs......\"",
      "text": "\"Somewhere we can catch some bugs......\""
    },
    {
      "offset": 1151,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「水遊び出来る所」",
      "en": "\"Somewhere we can play with water......\"",
      "text": "\"Somewhere we can play with water......\""
    },
    {
      "offset": 1182,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「高い所から、街を見下ろせる所」",
      "en": "\"......and somewhere we can look down at the city from high\nup.\"",
      "text": "\"......and somewhere we can look down at the city from high\nup.\""
    },
    {
      "offset": 1230,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 1255,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「公園より、ずっと楽しいよ」",
      "en": "\"It's more exciting than this park!\"",
      "text": "\"It's more exciting than this park!\""
    },
    {
      "offset": 1296,
      "speaker": "Keiichi",
      "speaker_jp": "啓一",
      "jp": "「だから、行こうよ、ね」",
      "en": "\"Let's go!\"",
      "text": "\"Let's go!\""
    },
    {
      "offset": 1331,
      "speaker": "Moe",
      "speaker_jp": "萌",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 1350,
      "speaker": "",
      "speaker_jp": "",
      "jp": "男の子が手を差し出す。それを見た萌先輩は、\n迷っている風だった。",
      "en": "The boy reached his hand out to her. Moe-sempai looked at\nhim uneasily.",
      "text": "The boy reached his hand out to her. Moe-sempai looked at\nhim uneasily."
    },
    {
      "offset": 1446,
      "speaker": "",
      "speaker_jp": "",
      "jp": "俺は、目を閉ざす。",
      "en": "I closed my eyes.",
      "text": "I closed my eyes."
    },
    {
      "offset": 1469,
      "speaker": "",
      "speaker_jp": "",
      "jp": "不意に、強い不安感に襲われて……。",
      "en": "All of the sudden, I was attacked by a fearful feeling......",
      "text": "All of the sudden, I was attacked by a fearful feeling......"
    },
    {
      "offset": 1508,
      "speaker": "",
      "speaker_jp": "",
      "jp": "行っちゃ駄目だ。二人とも……。",
      "en": "They both can't go......",
      "text": "They both can't go......"
    },
    {
      "offset": 1543,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…………。",
      "en": "............",
      "text": "............"
    },
    {
      "offset": 1558,
      "speaker": "",
      "speaker_jp": "",
      "jp": "遠ざかる足音。",
      "en": "Their footsteps were fading away.",
      "text": "Their footsteps were fading away."
    },
    {
      "offset": 1577,
      "speaker": "",
      "speaker_jp": "",
      "jp": "遠ざかる……。",
      "en": "They were fading.......",
      "text": "They were fading......."
    },
    {
      "offset": 1596,
      "speaker": "",
      "speaker_jp": "",
      "jp": "不安ばかりを、その場に残して……。",
      "en": "Nothing but fear was left in the park......",
      "text": "Nothing but fear was left in the park......"
    },
    {
      "offset": 1635,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……。",
      "en": "......",
      "text": "......"
    },
    {
      "offset": 1646,
      "speaker": "",
      "speaker_jp": "",
      "jp": "…。",
      "en": "...",
      "text": "..."
    },
    {
      "offset": 1759,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆夢３◆",
      "en": "◆Dream 3◆",
      "text": "◆Dream 3◆"
    },
    {
      "offset": 1798,
      "speaker": "",
      "speaker_jp": "",
      "jp": "幼い萌先輩と、男の子の夢……。",
      "en": "I saw a dream of young Moe-sempai and a boy.",
      "text": "I saw a dream of young Moe-sempai and a boy."
    },
    {
      "offset": 1833,
      "speaker": "",
      "speaker_jp": "",
      "jp": "俺は、不意に強い不安感に襲われた。",
      "en": "Suddenly, I was attacked by a feeling of tremendous fear.",
      "text": "Suddenly, I was attacked by a feeling of tremendous fear."
    }
  ],
