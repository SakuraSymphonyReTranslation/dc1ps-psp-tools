{
  "scene": "script_0403.obj",
  "dialogues": [
    {
      "offset": 113,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": "\"What is it?\"",
      "text": "\"What is it?\""
    },
    {
      "offset": 126,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": "My sleepy mindtried to find where the sound was coming from.",
      "text": "My sleepy mindtried to find where the sound was coming from."
    },
    {
      "offset": 146,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「ぬおっ！？」",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 190,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「な、なんだ？」",
      "en": "\"......Is this an alarm clock?\"",
      "text": "\"......Is this an alarm clock?\""
    },
    {
      "offset": 213,
      "speaker": "",
      "speaker_jp": "",
      "jp": "働かない頭で音の発信地を探す。",
      "en": "Why's the alarm clock going off? I didn't set it last\nnight......",
      "text": "Why's the alarm clock going off? I didn't set it last\nnight......"
    },
    {
      "offset": 248,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 265,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「……目覚し時計？」",
      "en": "\"Is it Nemu......? Argh......\"",
      "text": "\"Is it Nemu......? Argh......\""
    },
    {
      "offset": 292,
      "speaker": "",
      "speaker_jp": "",
      "jp": "なんで目覚ましが鳴ったんだ？　昨日はセット\nしなかったはずなのに……。",
      "en": "It's 10am right now. I was supposed to sleep in until noon.",
      "text": "It's 10am right now. I was supposed to sleep in until noon."
    },
    {
      "offset": 366,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": "\"Well, I guess I should wake up now.\"",
      "text": "\"Well, I guess I should wake up now.\""
    },
    {
      "offset": 381,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「音夢のやつか……はぁ」",
      "en": "\"Aaaw......\"",
      "text": "\"Aaaw......\""
    },
    {
      "offset": 417,
      "speaker": "",
      "speaker_jp": "",
      "jp": "時刻は１０時。予定では１２時以降に起きるは\nずだったのだが。",
      "en": "Guess I'll wash my face......",
      "text": "Guess I'll wash my face......"
    },
    {
      "offset": 690,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆１０時間睡眠◆",
      "en": "◆.  .  .◆",
      "text": "◆.  .  .◆"
    },
    {
      "offset": 728,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 743,
      "speaker": "",
      "speaker_jp": "",
      "jp": "目覚ましをセットした覚えは無いのだが、音夢\nのやつかな……まあ、十分寝たし、ここら辺で\n妥協しておくか。",
      "en": "\"What?\"",
      "text": "\"What?\""
    }
  ],
