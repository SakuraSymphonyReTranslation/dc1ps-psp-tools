{
  "scene": "script_0791.obj",
  "dialogues": [
    {
      "offset": 131,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 150,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 169,
      "speaker": "",
      "speaker_jp": "",
      "jp": "寝ぼけまなこで辺りを見渡す。",
      "en": "I looked around as I got up.",
      "text": "I looked around as I got up."
    },
    {
      "offset": 204,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「音夢？」",
      "en": "\"Nemu?\"",
      "text": "\"Nemu?\""
    },
    {
      "offset": 221,
      "speaker": "",
      "speaker_jp": "",
      "jp": "横にいたはずの妹が消えている。",
      "en": "Nemu was supposed to be next to me, but she's gone.",
      "text": "Nemu was supposed to be next to me, but she's gone."
    },
    {
      "offset": 258,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「出かけたんだっけ……」",
      "en": "\"Did she go out?\"",
      "text": "\"Did she go out?\""
    },
    {
      "offset": 289,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 308,
      "speaker": "",
      "speaker_jp": "",
      "jp": "携帯電話に手を伸ばして、日付を見た。",
      "en": "I reached out for my cell phone and looked at the date.",
      "text": "I reached out for my cell phone and looked at the date."
    },
    {
      "offset": 349,
      "speaker": "",
      "speaker_jp": "",
      "jp": "丸１日寝過ごしている。",
      "en": "I've slept all day.",
      "text": "I've slept all day."
    },
    {
      "offset": 376,
      "speaker": "",
      "speaker_jp": "",
      "jp": "しかも、すでに夕方近くになっている。",
      "en": "It's almost evening.",
      "text": "It's almost evening."
    },
    {
      "offset": 419,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「本当に寝すぎだよ俺……」",
      "en": "\"I slept way too much......\"",
      "text": "\"I slept way too much......\""
    },
    {
      "offset": 452,
      "speaker": "",
      "speaker_jp": "",
      "jp": "でも今日は昭和の日――祝日だ。",
      "en": "But today's a national holiday.",
      "text": "But today's a national holiday."
    },
    {
      "offset": 487,
      "speaker": "",
      "speaker_jp": "",
      "jp": "窓の外に目を向けた。",
      "en": "I looked out the window.",
      "text": "I looked out the window."
    },
    {
      "offset": 512,
      "speaker": "",
      "speaker_jp": "",
      "jp": "世界には穏やかな春の日差しが溢れている。",
      "en": "I saw gentle spring sun shining the world.",
      "text": "I saw gentle spring sun shining the world."
    },
    {
      "offset": 559,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 583,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「って、起きろよ！」",
      "en": "\"I better get up!\"",
      "text": "\"I better get up!\""
    },
    {
      "offset": 610,
      "speaker": "",
      "speaker_jp": "",
      "jp": "慌てて身を起こす。",
      "en": "I got up in a hurry.",
      "text": "I got up in a hurry."
    },
    {
      "offset": 635,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「寝ぼけてる場合じゃないって！」",
      "en": "\"I've no time to waste!\"",
      "text": "\"I've no time to waste!\""
    },
    {
      "offset": 674,
      "speaker": "",
      "speaker_jp": "",
      "jp": "音夢がいない。",
      "en": "Nemu's gone.",
      "text": "Nemu's gone."
    },
    {
      "offset": 695,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「っ」",
      "en": "\"Mm.\"",
      "text": "\"Mm.\""
    },
    {
      "offset": 708,
      "speaker": "",
      "speaker_jp": "",
      "jp": "上半身が沈んだ。",
      "en": "My upper body sunk.",
      "text": "My upper body sunk."
    },
    {
      "offset": 729,
      "speaker": "",
      "speaker_jp": "",
      "jp": "胸が痛む。",
      "en": "My heart ached.",
      "text": "My heart ached."
    },
    {
      "offset": 744,
      "speaker": "",
      "speaker_jp": "",
      "jp": "静かな鼓動の旋律。",
      "en": "The calm melody of a heartbeat.",
      "text": "The calm melody of a heartbeat."
    },
    {
      "offset": 767,
      "speaker": "",
      "speaker_jp": "",
      "jp": "切れかけたオルゴールの響き。",
      "en": "The echo of the broken music box.",
      "text": "The echo of the broken music box."
    },
    {
      "offset": 802,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 821,
      "speaker": "",
      "speaker_jp": "",
      "jp": "桜の花びらが消えていた。",
      "en": "The petals of the cherry blossoms were gone.",
      "text": "The petals of the cherry blossoms were gone."
    },
    {
      "offset": 855,
      "speaker": "",
      "speaker_jp": "",
      "jp": "リリン――",
      "en": "Ring.",
      "text": "Ring."
    },
    {
      "offset": 872,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「……！？」",
      "en": "\"......!?\"",
      "text": "\"......!?\""
    },
    {
      "offset": 906,
      "speaker": "Utamaru",
      "speaker_jp": "うたまる",
      "jp": "「にゃあ」",
      "en": "\"Meow.\"",
      "text": "\"Meow.\""
    },
    {
      "offset": 923,
      "speaker": "",
      "speaker_jp": "",
      "jp": "どこから入ってきたのか、うたまるがいた。",
      "en": "I don't know where she came in from, but I found Utamaru.",
      "text": "I don't know where she came in from, but I found Utamaru."
    },
    {
      "offset": 985,
      "speaker": "Utamaru",
      "speaker_jp": "うたまる",
      "jp": "「にゃ」",
      "en": "\"Meow.\"",
      "text": "\"Meow.\""
    },
    {
      "offset": 1005,
      "speaker": "",
      "speaker_jp": "",
      "jp": "リリン――リン――",
      "en": "Ring...... ring......",
      "text": "Ring...... ring......"
    },
    {
      "offset": 1030,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「…………」",
      "en": "\"............\"",
      "text": "\"............\""
    },
    {
      "offset": 1049,
      "speaker": "",
      "speaker_jp": "",
      "jp": "行って来ます。",
      "en": "I'll see you later.",
      "text": "I'll see you later."
    },
    {
      "offset": 1070,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「行って来ます！？」",
      "en": "\"I'll see you later?\"",
      "text": "\"I'll see you later?\""
    },
    {
      "offset": 1097,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「あいつがどこに行くんだよ？」",
      "en": "\"Where has she gone to?\"",
      "text": "\"Where has she gone to?\""
    },
    {
      "offset": 1134,
      "speaker": "",
      "speaker_jp": "",
      "jp": "トイレとかご飯を食べに、１階に行くための挨\n拶ではないだろう。",
      "en": "I'm sure she wouldn't have said that if she was going\ndownstairs to eat or use the bathroom.",
      "text": "I'm sure she wouldn't have said that if she was going\ndownstairs to eat or use the bathroom."
    },
    {
      "offset": 1200,
      "speaker": "",
      "speaker_jp": "",
      "jp": "コンビニに買出しだろうか……。",
      "en": "Did she go to the market?",
      "text": "Did she go to the market?"
    },
    {
      "offset": 1248,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "『お出かけするときは元気に元気に♪』",
      "en": "\"\"I have to be happy when I go out!\"\"",
      "text": "\"\"I have to be happy when I go out!\"\""
    },
    {
      "offset": 1304,
      "speaker": "Sakura",
      "speaker_jp": "さくら",
      "jp": "（ささやかな願いごとだよ）",
      "en": "(It's a small wish.)",
      "text": "(It's a small wish.)"
    },
    {
      "offset": 1348,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "『それじゃあ、行って来ます！』",
      "en": "\"\"Okay, then. I'll see you later!!\"\"",
      "text": "\"\"Okay, then. I'll see you later!!\"\""
    },
    {
      "offset": 1398,
      "speaker": "Sakura",
      "speaker_jp": "さくら",
      "jp": "（笑っちゃうくらいささやかなんだよ……）",
      "en": "(It's so small you might laugh......)",
      "text": "(It's so small you might laugh......)"
    },
    {
      "offset": 1456,
      "speaker": "Nemu",
      "speaker_jp": "音夢",
      "jp": "『さよなら、兄さん』",
      "en": "\"\"Goodbye, niisan.\"\"",
      "text": "\"\"Goodbye, niisan.\"\""
    },
    {
      "offset": 1496,
      "speaker": "Sakura",
      "speaker_jp": "さくら",
      "jp": "（お兄ちゃんにしか叶えられないんだ）",
      "en": "(You're the only one who can make it come true for her.)",
      "text": "(You're the only one who can make it come true for her.)"
    },
    {
      "offset": 1539,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": ". . .",
      "text": ". . ."
    },
    {
      "offset": 1552,
      "speaker": "",
      "speaker_jp": "",
      "jp": "落ち着いて携帯に電話をかけたが、電源を切ら\nれているという無感情な響きが流れるだけ。",
      "en": "I calmed down and called her on her cell phone, but all I\ngot was the answering machine telling me that her phone was\nturned off at the moment.",
      "text": "I calmed down and called her on her cell phone, but all I\ngot was the answering machine telling me that her phone was\nturned off at the moment."
    },
    {
      "offset": 1642,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「俺にしか叶えられないささやかな願い」",
      "en": "\"A small wish that only I can make happen.\"",
      "text": "\"A small wish that only I can make happen.\""
    },
    {
      "offset": 1687,
      "speaker": "",
      "speaker_jp": "",
      "jp": "俺も行かないといけない……。",
      "en": "I have to go......",
      "text": "I have to go......"
    },
    {
      "offset": 1903,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆たった１つの願いへ◆",
      "en": "◆The one wish◆",
      "text": "◆The one wish◆"
    },
    {
      "offset": 1954,
      "speaker": "",
      "speaker_jp": "",
      "jp": "音夢が家から姿を消していた。",
      "en": "Nemu disappeared from home.",
      "text": "Nemu disappeared from home."
    },
    {
      "offset": 1987,
      "speaker": "",
      "speaker_jp": "",
      "jp": "あんな身体でどこにとも思ったが、あんな状態\nだからこそ、音夢は、さくらが言っていたちっ\nぽけな願いを叶えるために出かけたのだろう。",
      "en": "How could she have gone out right now? But maybe she went\nout to make her small wish come true, as Sakura had said.",
      "text": "How could she have gone out right now? But maybe she went\nout to make her small wish come true, as Sakura had said."
    },
    {
      "offset": 2120,
      "speaker": "",
      "speaker_jp": "",
      "jp": "俺は、そのささやかな夢を考え、音夢の後を追\nわなくてはならなかった。",
      "en": "I have to think about what's the small dream she has, and go\nafter her.",
      "text": "I have to think about what's the small dream she has, and go\nafter her."
    }
  ],
  "choices": [
    {
      "offset": 1730,
      "jp": "○枯れない桜へ",
      "en": "○To the everlasting cherry tree.",
      "text": "○To the everlasting cherry tree."
    },
    {
      "offset": 1753,
      "jp": "○学園へ",
      "en": "○To school.",
      "text": "○To school."
    }
  ],
