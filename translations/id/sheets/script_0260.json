{
  "scene": "script_0260.obj",
  "dialogues": [
    {
      "offset": 142,
      "speaker": "Kudou",
      "speaker_jp": "工藤",
      "jp": "「朝倉」",
      "en": "\"Asakura.\"",
      "text": "\"Asakura.\""
    },
    {
      "offset": 157,
      "speaker": "",
      "speaker_jp": "",
      "jp": "工藤――？",
      "en": "Kudou--?",
      "text": "Kudou--?"
    },
    {
      "offset": 185,
      "speaker": "Suginami",
      "speaker_jp": "杉並",
      "jp": "「よーぅ、朝倉」",
      "en": "\"Yo, Asakura.\"",
      "text": "\"Yo, Asakura.\""
    },
    {
      "offset": 208,
      "speaker": "",
      "speaker_jp": "",
      "jp": "げ、杉並……。\nなんなんだ、一体？",
      "en": "Kuh, Suginami... what's going on?\"",
      "text": "Kuh, Suginami... what's going on?\""
    },
    {
      "offset": 259,
      "speaker": "Kudou",
      "speaker_jp": "工藤",
      "jp": "「お早っす、朝倉」",
      "en": "\"Good morning, Asakura!\"",
      "text": "\"Good morning, Asakura!\""
    },
    {
      "offset": 284,
      "speaker": "Kudou",
      "speaker_jp": "工藤",
      "jp": "「…………」",
      "en": "\"......\"",
      "text": "\"......\""
    },
    {
      "offset": 303,
      "speaker": "",
      "speaker_jp": "",
      "jp": "……もう朝、か？",
      "en": "...It's morning already?",
      "text": "...It's morning already?"
    },
    {
      "offset": 324,
      "speaker": "",
      "speaker_jp": "",
      "jp": "・\n・\n・",
      "en": "・ ・ ・",
      "text": "・ ・ ・"
    },
    {
      "offset": 348,
      "speaker": "Koyomi",
      "speaker_jp": "暦",
      "jp": "「いい加減にしろ！」",
      "en": "\"Get up already!\"",
      "text": "\"Get up already!\""
    },
    {
      "offset": 386,
      "speaker": "",
      "speaker_jp": "",
      "jp": "バコッ――！",
      "en": "--*thwack!*",
      "text": "--*thwack!*"
    },
    {
      "offset": 405,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「ぐっ……」",
      "en": "\"Gurf...\"",
      "text": "\"Gurf...\""
    },
    {
      "offset": 479,
      "speaker": "Koyomi",
      "speaker_jp": "暦",
      "jp": "「やっと起きたか……」",
      "en": "\"Finally awake...\"",
      "text": "\"Finally awake...\""
    },
    {
      "offset": 508,
      "speaker": "",
      "speaker_jp": "",
      "jp": "出席簿をもった暦先生が、俺を見下ろしている。",
      "en": "Koyomi-sensei was holding the class register, staring down\nat me.",
      "text": "Koyomi-sensei was holding the class register, staring down\nat me."
    },
    {
      "offset": 559,
      "speaker": "",
      "speaker_jp": "",
      "jp": "「あれ……暦先生、何してんの？」",
      "en": "\"Ahh.... Koyomi-sensei, what's up?\"",
      "text": "\"Ahh.... Koyomi-sensei, what's up?\""
    },
    {
      "offset": 607,
      "speaker": "Koyomi",
      "speaker_jp": "暦",
      "jp": "「授業だ。もう終わったけどな」",
      "en": "\"Class is still on. If you want to sleep, wait a few more\nminutes for it to end.\"",
      "text": "\"Class is still on. If you want to sleep, wait a few more\nminutes for it to end.\""
    },
    {
      "offset": 644,
      "speaker": "",
      "speaker_jp": "",
      "jp": "出席簿片手に、暦先生が教壇に戻っていく。",
      "en": "Holding the register in one hand, Koyomi-sensei returned to\nher desk.",
      "text": "Holding the register in one hand, Koyomi-sensei returned to\nher desk."
    },
    {
      "offset": 700,
      "speaker": "Koyomi",
      "speaker_jp": "暦",
      "jp": "「じゃあ週番、号令」",
      "en": "\"Now, weekly duty?\"",
      "text": "\"Now, weekly duty?\""
    },
    {
      "offset": 727,
      "speaker": "",
      "speaker_jp": "",
      "jp": "週番の号令を聞きながら、俺は｛あくび／欠伸｝をかみ殺し\nた……。",
      "en": "If I yawn while the weekly duty is doing his stuff, she'd\nkill me for sure...",
      "text": "If I yawn while the weekly duty is doing his stuff, she'd\nkill me for sure..."
    },
    {
      "offset": 795,
      "speaker": "",
      "speaker_jp": "",
      "jp": "いつの間にか、２時限目の授業――終わってた\nんだな……。",
      "en": "And the usual two-period class then ended...",
      "text": "And the usual two-period class then ended..."
    },
    {
      "offset": 966,
      "speaker": "",
      "speaker_jp": "",
      "jp": "◆工藤と杉並の夢◆",
      "en": "◆A Dream of Kudou and Suginami◆",
      "text": "◆A Dream of Kudou and Suginami◆"
    },
    {
      "offset": 1006,
      "speaker": "",
      "speaker_jp": "",
      "jp": "工藤の夢を見た。",
      "en": "I had a dream of Kudou.",
      "text": "I had a dream of Kudou."
    },
    {
      "offset": 1027,
      "speaker": "",
      "speaker_jp": "",
      "jp": "工藤が、俺を優しく起こしてくれる夢だ……。",
      "en": "One where he was gently waking me up...",
      "text": "One where he was gently waking me up..."
    }
  ],
